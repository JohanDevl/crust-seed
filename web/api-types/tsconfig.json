{
	"compilerOptions": {
		"composite": true,
		"types": ["node"],
		"skipLibCheck": true,
		"target": "es2022",
		"lib": ["es2023", "dom"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"strict": true,
		"noEmit": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
	},
	"references": [{ "path": "../shared/tsconfig.build.json" }],
	"include": ["./src/**/*"]
}
